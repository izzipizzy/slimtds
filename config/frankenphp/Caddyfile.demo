# Demo deploy — behind Cloudflare (SSL mode "Full"), whole domain gated by basic auth
# until launch. Serves: landing (/), docs (/docs), and the PHP app (/admin, engine
# hot-path, pixel, postback). Origin TLS is a self-signed internal cert — CF "Full"
# (non-strict) accepts it; CF terminates the public cert and proxies to :443.
{
    frankenphp {
        worker {
            file /app/public/index.php
            num 8
        }
    }
    servers {
        # Trust Cloudflare so CF-Connecting-IP is honoured for real client IP.
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
        client_ip_headers CF-Connecting-IP
    }
    # No public ACME (CF is in front); just don't do http->https redirects ourselves.
    auto_https disable_redirects
    admin off
}

https://{$DOMAIN} {
    tls internal
    encode zstd gzip


    # ── Docs (Starlight, built with base /docs) ──
    handle_path /docs/* {
        root * /srv/docs
        file_server
    }
    redir /docs /docs/ 301

    # ── PHP app: admin + machine endpoints (pixel/postback) ──
    @app path /admin /admin/* /p.js /p/event /postback
    handle @app {
        root * /app/public
        @pjs path /p.js
        header @pjs Access-Control-Allow-Origin *
        php_server
    }

    # ── Landing (root + Astro assets + RU + static files) ──
    @landing path / /_astro/* /ru /ru/* /favicon.svg /favicon.ico /robots.txt
    handle @landing {
        root * /srv/landing
        file_server
    }

    # ── Engine hot-path /<slug> → PHP app (everything else) ──
    handle {
        root * /app/public
        php_server
    }
}
