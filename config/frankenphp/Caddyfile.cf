{
    frankenphp {
        worker {
            file /app/config/frankenphp/worker.php
            # Prod: 4 vCPU. Run 8 workers (2x cores) so synchronous request
            # paths (DB roundtrips) don't pin a single core. Without `num`,
            # FrankenPHP runs 1 worker and saturates one CPU only.
            num 8
        }
    }
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
        client_ip_headers CF-Connecting-IP
    }
    auto_https off
    admin off
}

:{$CF_LISTEN_PORT:80} {
    root * /app/public
    encode zstd gzip

    @static path /assets/* /p.js /favicon.ico /robots.txt
    handle @static { file_server }

    @pjs path /p.js
    header @pjs Access-Control-Allow-Origin *

    php_server
}
