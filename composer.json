{
    "name": "claude/slim-tds",
    "description": "Slim-based TDS (Traffic Distribution System)",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.5",
        "geoip2/geoip2": "^3.4",
        "mobiledetect/mobiledetectlib": "^4.11",
        "php-di/php-di": "^7.1",
        "php-di/slim-bridge": "^3.4.1",
        "ramsey/uuid": "^4.9.4",
        "respect/validation": "^3.1",
        "robmorgan/phinx": "^0.16.12",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15.3",
        "symfony/console": "^8.1",
        "symfony/process": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/yaml": "^8.1",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-browser": "^5.1",
        "phpstan/phpstan": "^2.2",
        "fakerphp/faker": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Shared/View/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
